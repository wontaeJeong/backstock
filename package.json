{
  "name": "backstock",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @backstock/web dev",
    "build": "pnpm --filter @backstock/web build",
    "lint": "pnpm --filter @backstock/web lint",
    "typecheck": "pnpm --filter @backstock/web typecheck",
    "test": "pnpm --filter @backstock/web test",
    "doctor": "pnpm --filter @backstock/web doctor"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
